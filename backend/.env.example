DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_tracking
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_MAX_SIZE=52428800
STORAGE_PATH=./storage/uploads
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production
# Optional server-side key required to register an Administrator account via
# the public /auth/register endpoint. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty to disable admin-key registration.
ADMIN_REGISTRATION_SECRET=
